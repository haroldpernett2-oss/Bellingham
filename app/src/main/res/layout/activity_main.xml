<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="BELLINGHAM"
            android:textColor="@color/gold_dark"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Optimización de rendimiento"
            android:textColor="@color/gray_text"
            android:textSize="14sp"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Shizuku no conectado"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:gravity="center"
            android:padding="12dp"
            android:background="@color/off_white"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/connectButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Conectar Shizuku"
            android:textColor="@color/white"
            android:background="@drawable/button_gold"
            android:layout_marginBottom="28dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MODO RÁPIDO"
            android:textColor="@color/gold_dark"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnModoGamer"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="⚡ Modo Gamer (todo en uno)"
            android:textColor="@color/white"
            android:background="@drawable/button_gold"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnModoNormal"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Modo Normal (restaurar todo)"
            android:textColor="@color/gold_dark"
            android:background="@drawable/button_outline"
            android:layout_marginBottom="28dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MODO JUEGO (POR JUEGO)"
            android:textColor="@color/gold_dark"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnElegirJuego"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Elegir juego de mi lista de apps"
            android:textColor="@color/gold_dark"
            android:background="@drawable/button_outline"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/etPackage"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="com.dts.freefireth"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:padding="12dp"
            android:singleLine="true"
            android:background="@color/off_white"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnGameMedio"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Rendimiento medio (70% · 60 FPS)"
            android:textColor="@color/gold_dark"
            android:background="@drawable/button_outline"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnGameMax"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Rendimiento máximo (50% · 30 FPS)"
            android:textColor="@color/gold_dark"
            android:background="@drawable/button_outline"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnCompilar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Optimizar juego (compilar)"
            android:textColor="@color/gold_dark"
            android:background="@drawable/button_outline"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnGameReset"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Quitar ajuste del juego"
            android:textColor="@color/white"
            android:background="@drawable/button_gold"
            android:layout_marginBottom="28dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LIMITADOR DE FPS (PANTALLA)"
            android:textColor="@color/gold_dark"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnFps30"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="30 Hz"
            android:textColor="@color/gold_dark"
            android:background="@drawable/button_outline"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnFps60"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="60 Hz"
            android:textColor="@color/gold_dark"
            android:background="@drawable/button_outline"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnFps90"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="90 Hz"
            android:textColor="@color/gold_dark"
            android:background="@drawable/button_outline"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnFpsReset"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Automático (restaurar)"
            android:textColor="@color/white"
            android:background="@drawable/button_gold"
            android:layout_marginBottom="28dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RESOLUCIÓN DE PANTALLA"
            android:textColor="@color/gold_dark"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnOriginal"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Original (restaurar)"
            android:textColor="@color/gold_dark"
            android:background="@drawable/button_outline"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnMedia"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Media (720x1280)"
            android:textColor="@color/gold_dark"
            android:background="@drawable/button_outline"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnBaja"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Baja (540x960)"
            android:textColor="@color/gold_dark"
            android:background="@drawable/button_outline"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnUltraBaja"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Ultra baja (480x854)"
            android:textColor="@color/gold_dark"
            android:background="@drawable/button_outline"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/dpiLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Densidad (DPI): auto"
            android:textColor="@color/gray_text"
            android:textSize="12sp"
            android:layout_marginBottom="4dp"/>

        <SeekBar
            android:id="@+id/dpiSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="320"
            android:progress="160"
            android:layout_marginBottom="28dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EXTRAS"
            android:textColor="@color/gold_dark"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnOverlayStart"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Activar overlay de FPS/RAM en pantalla"
            android:textColor="@color/gold_dark"
            android:background="@drawable/button_outline"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnOverlayStop"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Detener overlay"
            android:textColor="@color/gold_dark"
            android:background="@drawable/button_outline"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnAnimOff"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Quitar animaciones del sistema"
            android:textColor="@color/gold_dark"
            android:background="@drawable/button_outline"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnAnimOn"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Restaurar animaciones"
            android:textColor="@color/gold_dark"
            android:background="@drawable/button_outline"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnRam"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Cerrar apps en segundo plano"
            android:textColor="@color/white"
            android:background="@drawable/button_gold"
            android:layout_marginBottom="40dp"/>

    </LinearLayout>
</ScrollView>
